# ==============================================================================
# Trutina — Test environment
# Copy to `.env.test` before running the test suite.
# Tests use dedicated databases and must not use development databases.
# Every variable here uses the TRUTINA_TEST_ prefix: TestSettings reads only
# that namespace and ignores TRUTINA_* variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------
# production | development | test  (default: production, fails closed)
TRUTINA_TEST_ENVIRONMENT=test


# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
TRUTINA_TEST_POSTGRES__URI=postgresql+asyncpg://username:password@localhost:5432/trutina_test

# Connection pool
TRUTINA_TEST_POSTGRES__CONNECT_TIMEOUT_S=5.0
TRUTINA_TEST_POSTGRES__POOL_SIZE=1
TRUTINA_TEST_POSTGRES__MAX_OVERFLOW=10
TRUTINA_TEST_POSTGRES__POOL_PRE_PING=true


# ------------------------------------------------------------------------------
# API
# ------------------------------------------------------------------------------
TRUTINA_TEST_API__HOST=127.0.0.1
TRUTINA_TEST_API__PORT=8000
TRUTINA_TEST_API__RELOAD=true

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# Values below intentionally equal the LoggingSettings defaults, so tests that
# assert defaults on TestSettings() are not affected by this file. Tests that
# need other values should use monkeypatch.setenv, not edit this file.
TRUTINA_TEST_LOGGING__LEVEL=INFO
TRUTINA_TEST_LOGGING__FORMAT=console
TRUTINA_TEST_LOGGING__SINK=auto
# TRUTINA_TEST_LOGGING__FILE_PATH=
TRUTINA_TEST_LOGGING__FILE_MAX_BYTES=5000000
TRUTINA_TEST_LOGGING__FILE_BACKUP_COUNT=3
# TRUTINA_TEST_LOGGING__LOGGER_LEVELS={"sqlalchemy.engine": "WARNING"}


# ------------------------------------------------------------------------------
# Authentication (no keys needed until the token milestone)
# ------------------------------------------------------------------------------
# Key ids are case-folded; do not use "__" in a kid.
# TRUTINA_TEST_AUTH__SIGNING_KEYS__k1=<random secret, at least 32 bytes>
# TRUTINA_TEST_AUTH__ACTIVE_KID=k1

# Password hashing (Argon2id). Values shown are the defaults. Hasher tests
# construct the hasher directly with the cheapest parameters, so nothing in
# the suite needs these set.
# TRUTINA_TEST_AUTH__PASSWORD_TIME_COST=3
# TRUTINA_TEST_AUTH__PASSWORD_MEMORY_COST_KIB=65536
# TRUTINA_TEST_AUTH__PASSWORD_PARALLELISM=1
# TRUTINA_TEST_AUTH__PASSWORD_HASH_CONCURRENCY=4

# Login throttling: after LOGIN_MAX_FAILURES failed logins for one IP and email
# within LOGIN_WINDOW_SECONDS, further attempts are rejected until the window
# passes. Values shown are the defaults.
# TRUTINA_TEST_AUTH__LOGIN_MAX_FAILURES=5
# TRUTINA_TEST_AUTH__LOGIN_WINDOW_SECONDS=900