# ==============================================================================
# Trutina — Test environment
# Copy to `.env.test` before running the test suite.
# Tests use dedicated databases and must not use development databases.
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------------------------
TRUTINA_TEST_MONGO__URI=mongodb://localhost:27017
TRUTINA_TEST_MONGO__DB=trutina_test

# Connection and retry behavior
TRUTINA_TEST_MONGO__SERVER_SELECTION_TIMEOUT_MS=5000
TRUTINA_TEST_MONGO__MIN_POOL_SIZE=1
TRUTINA_TEST_MONGO__RETRY_READS=true
TRUTINA_TEST_MONGO__RETRY_WRITES=true


# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
TRUTINA_TEST_POSTGRES__URI=postgresql+asyncpg://username:password@localhost:5432/trutina_test

# Connection pool
TRUTINA_TEST_POSTGRES__CONNECT_TIMEOUT_S=5.0
TRUTINA_TEST_POSTGRES__POOL_SIZE=1
TRUTINA_TEST_POSTGRES__MAX_OVERFLOW=10
TRUTINA_TEST_POSTGRES__POOL_PRE_PING=true


# ------------------------------------------------------------------------------
# API
# ------------------------------------------------------------------------------
TRUTINA_TEST_API__HOST=127.0.0.1
TRUTINA_TEST_API__PORT=8000
TRUTINA_TEST_API__RELOAD=true