# ==============================================================================
# Trutina — Local development environment
# Copy to `.env` and adjust values as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------
# production | development | test  (default: production, fails closed)
TRUTINA_ENVIRONMENT=development

# ------------------------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------------------------
TRUTINA_MONGO__URI=mongodb://localhost:27017
TRUTINA_MONGO__DB=trutina

# Connection and retry behavior
TRUTINA_MONGO__SERVER_SELECTION_TIMEOUT_MS=5000
TRUTINA_MONGO__MIN_POOL_SIZE=1
TRUTINA_MONGO__RETRY_READS=true
TRUTINA_MONGO__RETRY_WRITES=true


# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
TRUTINA_POSTGRES__URI=postgresql+asyncpg://username:password@localhost:5432/trutina

# Connection pool
TRUTINA_POSTGRES__CONNECT_TIMEOUT_S=5.0
TRUTINA_POSTGRES__POOL_SIZE=1
TRUTINA_POSTGRES__MAX_OVERFLOW=10
TRUTINA_POSTGRES__POOL_PRE_PING=true


# ------------------------------------------------------------------------------
# API
# ------------------------------------------------------------------------------
TRUTINA_API__HOST=127.0.0.1
TRUTINA_API__PORT=8000
TRUTINA_API__RELOAD=true

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL (case-insensitive)
TRUTINA_LOGGING__LEVEL=INFO

# json | console | auto  (auto: API -> json, CLI -> json)
TRUTINA_LOGGING__FORMAT=console

# stdout | stderr | file | auto  (auto: API -> stdout, CLI -> file)
TRUTINA_LOGGING__SINK=auto

# Rotating file sink (used when the sink resolves to "file").
# Leave FILE_PATH unset to use the platform log directory.
# TRUTINA_LOGGING__FILE_PATH=
TRUTINA_LOGGING__FILE_MAX_BYTES=5000000
TRUTINA_LOGGING__FILE_BACKUP_COUNT=3

# JSON object of per-logger levels. Setting this REPLACES the whole default
# mapping, so restate any default you want to keep.
# TRUTINA_LOGGING__LOGGER_LEVELS={"sqlalchemy.engine": "WARNING", "uvicorn.error": "INFO"}

# ------------------------------------------------------------------------------
# Authentication (no keys needed until the token milestone)
# ------------------------------------------------------------------------------
# Key ids are case-folded; do not use "__" in a kid.
# TRUTINA_AUTH__SIGNING_KEYS__k1=<random secret, at least 32 bytes>
# TRUTINA_AUTH__ACTIVE_KID=k1